# backend/.env namunasi - haqiqiy qiymatlar bilan to'ldirib, shu papkaga
# "backend/.env" nomi bilan saqlang. Har bir o'zgaruvchi izohi
# backend/config.py'da ham bor - u yerda MAJBURIY/ixtiyoriyligi va
# standart qiymati aniq ko'rinadi.

# ============ MAJBURIY ============

# PostgreSQL ulanish manzili. PORT diqqat bilan tekshiring - har bir
# kompyuterda boshqacha bo'lishi mumkin.
DATABASE_URL=postgresql+psycopg2://postgres:PAROL@localhost:5432/hazorasp_tarozi?client_encoding=utf8

# JWT tokenlarni imzolash uchun tasodifiy, uzun maxfiy satr (masalan:
# python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=REPLACE_ME_TASODIFIY_UZUN_MAXFIY_SATR

# ============ AMALDA MAJBURIY (standart bo'sh, lekin funksiyalar shu
# kalitga bog'liq) ============

# Tarozi agenti (tarozi_agent/.env) bilan BIR XIL qiymat bo'lishi
# shart - mos kelmasa POST /tarozi/yubor so'rovi rad etiladi.
TAROZI_AGENT_KEY=REPLACE_ME_SAME_AS_tarozi_agent_.env

# ============ IXTIYORIY - standart qiymatlar yetarli ============

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - brauzerdan so'rov yuborishga ruxsat berilgan manzillar
# (vergul bilan ajratilgan). Standart qiymat faqat doimiy domenlar +
# localhost'ni o'z ichiga oladi - MAHALLIY TARMOQ (LAN, ofis ichi)
# manzilini HAR BIR SERVERDA shu yerga QO'LDA qo'shish kerak (masalan
# http://10.x.x.x:47080), aks holda ofis kompyuterlari backend'ga
# to'g'ridan-to'g'ri (internetsiz) ulana olmaydi.
# ALLOWED_ORIGINS=https://smart-tarozi.uz,https://app.smart-tarozi.uz,http://localhost:47080,http://<shu-server-LAN-IP>:47080

# pg_dump.exe to'liq yo'li - kunlik avtomatik baza zaxirasi uchun.
# Bo'sh bo'lsa, backup jimgina ishlamay qoladi (tizim_xatolari
# jadvalida qayd etiladi).
PG_DUMP_YOL=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Baza zaxira nusxalari va tortish tasdiqlovchi rasmlar/nakladnoy
# fayllari qayerga saqlanishi.
# BACKUP_DIR=C:\hazorasp_tarozi\backup
# RASMLAR_DIR=C:\RASMLAR

# Frontend'ning ApiService.baseUrl bilan bir xil bo'lishi kerak - QR
# kod (nakladnoy ochiq sahifasi) shu manzilga asoslanadi.
# SERVER_ASOSIY_URL=http://<shu-server-LAN-IP>:47001

# Tunnel/tarmoq o'z-o'zini kuzatish uchun ommaviy domen manzili -
# odatda o'zgartirish shart emas.
# TUNNEL_TEKSHIRUV_URL=https://api.smart-tarozi.uz/health

# ============ IXTIYORIY - to'ldirilmasa, tegishli funksiya xato
# bermay, shunchaki o'chiq holda ishlaydi ============

# Telegram ogohlantirish boti (texnik xatolar - tarozi, tunnel, kamera).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram hisobot boti (kunlik statistika) - ogohlantirish botidan
# ATAYLAB alohida.
TELEGRAM_HISOBOT_TOKEN=
TELEGRAM_HISOBOT_CHAT_ID=

# Ikkinchi kompyuterga (SMB ulashuv) tashqi backup. Barchasi
# to'ldirilmaguncha (IP, foydalanuvchi, parol) tarmoqqa ko'chirish
# umuman urinilmaydi - faqat mahalliy backup ishlayveradi.
TARMOQ_BACKUP_IP=
TARMOQ_BACKUP_SHARE=Backup
TARMOQ_BACKUP_FOYDALANUVCHI=
TARMOQ_BACKUP_PAROL=

# Kamera (HikCentral) integratsiyasi - tortish tasdiqlovchi rasmlar.
KAMERA_1_IP=
KAMERA_2_IP=
KAMERA_LOGIN=
KAMERA_PAROL=
